// Cấu hình Metro của Expo + 1 điều chỉnh:
// mọi `import ... from 'react-native'` trong CODE CỦA APP (không phải thư viện trong node_modules)
// được chuyển qua ChuCoDinh.js để giới hạn cỡ chữ khi điện thoại bật chữ lớn.
const path = require('path');
const { getDefaultConfig } = require('expo/metro-config');

const config = getDefaultConfig(__dirname);
const FILE_BOC_CHU = path.resolve(__dirname, 'ChuCoDinh.js');
const giaiQuyetGoc = config.resolver.resolveRequest;

config.resolver.resolveRequest = (context, moduleName, platform) => {
  const tuFile = path.resolve(context.originModulePath || '');
  const laCodeApp = !tuFile.includes(`${path.sep}node_modules${path.sep}`);
  if (moduleName === 'react-native' && laCodeApp && tuFile !== FILE_BOC_CHU) {
    return { type: 'sourceFile', filePath: FILE_BOC_CHU };
  }
  return giaiQuyetGoc ? giaiQuyetGoc(context, moduleName, platform) : context.resolveRequest(context, moduleName, platform);
};

module.exports = config;